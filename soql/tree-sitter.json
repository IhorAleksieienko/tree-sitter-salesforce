{
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for SOQL",
    "authors": [
      {
        "name": "Ihor A."
      }
    ],
    "links": {
      "repository": "https://github.com/ia/tree-sitter-salesforce.git"
    }
  },
  "grammars": [
    {
      "name": "soql",
      "camelcase": "Soql",
      "scope": "source.soql",
      "file-types": ["soql"],
      "highlights": [
        "queries/highlights-distinct.scm",
        "queries/highlights.scm"
      ]
    }
  ],
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "kotlin": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
