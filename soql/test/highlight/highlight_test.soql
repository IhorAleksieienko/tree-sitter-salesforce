// This is a SOQL highlight test
// <- comment

SELECT Id, Name
// <- keyword
//     ^ property
//         ^ property
FROM Account
// <- keyword
//   ^ type
WHERE CreatedDate = YESTERDAY
// <- keyword
//    ^ property
//                ^ operator
//                  ^ type
WITH USER_MODE
// <- keyword
//   ^ keyword
LIMIT 100
// <- keyword
//    ^ number
