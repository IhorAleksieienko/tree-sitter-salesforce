{
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammars for Salesforce's Apex, Anonymous Apex, SOQL, SOSL, Formula, and Debug Log languages",
    "authors": [
      {
        "name": "Ihor A."
      }
    ],
    "links": {
      "repository": "https://github.com/ia/tree-sitter-salesforce.git"
    }
  },
  "grammars": [
    {
      "name": "apex",
      "camelcase": "Apex",
      "scope": "source.apex",
      "path": "apex",
      "file-types": ["cls", "trigger"],
      "highlights": [
        "apex/queries/highlights.scm"
      ],
      "injections": [
        "apex/queries/injections.scm"
      ],
      "locals": [
        "apex/queries/locals.scm"
      ],
      "tags": [
        "apex/queries/tags.scm"
      ]
    },
    {
      "name": "apex_anon",
      "camelcase": "ApexAnon",
      "scope": "source.apex.anon",
      "path": "apex-anon",
      "file-types": ["apex"],
      "highlights": [
        "apex-anon/queries/highlights.scm"
      ],
      "injections": [
        "apex-anon/queries/injections.scm"
      ]
    },
    {
      "name": "soql",
      "camelcase": "Soql",
      "scope": "source.soql",
      "path": "soql",
      "file-types": ["soql"],
      "highlights": [
        "soql/queries/highlights-distinct.scm",
        "soql/queries/highlights.scm"
      ]
    },
    {
      "name": "sosl",
      "camelcase": "Sosl",
      "scope": "source.sosl",
      "path": "sosl",
      "file-types": ["sosl"],
      "highlights": [
        "sosl/queries/highlights.scm"
      ]
    },
    {
      "name": "formula",
      "camelcase": "Formula",
      "scope": "source.formula",
      "path": "formula",
      "file-types": ["formula"],
      "highlights": [
        "formula/queries/highlights.scm"
      ]
    },
    {
      "name": "sflog",
      "camelcase": "Sflog",
      "scope": "source.sflog",
      "path": "sflog",
      "file-types": ["log"],
      "highlights": [
        "sflog/queries/highlights.scm"
      ]
    }
  ],
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "kotlin": false,
    "node": true,
    "python": true,
    "rust": false,
    "swift": false
  }
}
