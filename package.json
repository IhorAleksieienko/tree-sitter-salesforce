{
  "name": "tree-sitter-salesforce",
  "version": "0.2.0",
  "description": "Tree-sitter grammars for Salesforce languages: Apex, SOQL, and more",
  "homepage": "https://github.com/ia/tree-sitter-salesforce",
  "license": "MIT",
  "author": {
    "name": "Ihor A."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ia/tree-sitter-salesforce.git"
  },
  "keywords": [
    "tree-sitter",
    "parser",
    "salesforce",
    "apex",
    "soql",
    "sosl",
    "formula",
    "incremental",
    "parsing"
  ],
  "dependencies": {
    "node-addon-api": "^8.7.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.4"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.25.0"
  },
  "main": "bindings/node",
  "scripts": {
    "build": "npm run generate:all",
    "generate:all": "node scripts/generate-all.js",
    "build:wasm": "node scripts/build-wasm.js",
    "test:all": "node scripts/test-all.js",
    "test": "node scripts/test-all.js",
    "install": "node -e \"try { require('child_process').execSync('node-gyp-build', { stdio: 'inherit' }); } catch (e) {}\""
  },
  "files": [
    "*/queries/*",
    "*/src/grammar.json",
    "*/src/node-types.json",
    "*/src/parser.c",
    "*/src/tree_sitter/parser.h",
    "bindings/node/*.js",
    "bindings/node/*.ts",
    "bindings/node/binding.cc",
    "bindings/web/*",
    "binding.gyp",
    "prebuilds/**"
  ]
}
