    "debug_message": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]*"
        }
      }
    },
    "soql_begin_event": {
