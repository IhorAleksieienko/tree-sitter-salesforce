{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "sflog",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "log_header"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "limit_usage_section"
              },
              {
                "type": "SYMBOL",
                "name": "event_line"
              },
              {
                "type": "SYMBOL",
                "name": "stack_trace_line"
              },
              {
                "type": "SYMBOL",
                "name": "raw_line"
              }
            ]
          }
        }
      ]
    },
    "log_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "version",
          "content": {
            "type": "SYMBOL",
            "name": "api_version"
          }
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "category_filter"
          }
        }
      ]
    },
    "api_version": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\d+\\.\\d+"
      }
    },
    "category_filter": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "category",
          "content": {
            "type": "SYMBOL",
            "name": "category_identifier"
          }
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "FIELD",
          "name": "level",
          "content": {
            "type": "SYMBOL",
            "name": "log_level"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ";"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "category_identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Z_]+"
      }
    },
    "log_level": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "NONE"
        },
        {
          "type": "STRING",
          "value": "ERROR"
        },
        {
          "type": "STRING",
          "value": "WARN"
        },
        {
          "type": "STRING",
          "value": "INFO"
        },
        {
          "type": "STRING",
          "value": "DEBUG"
        },
        {
          "type": "STRING",
          "value": "FINE"
        },
        {
          "type": "STRING",
          "value": "FINER"
        },
        {
          "type": "STRING",
          "value": "FINEST"
        }
      ]
    },
    "timestamp": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\d{2}:\\d{2}:\\d{2}\\.\\d{3}"
      }
    },
    "nanoseconds": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\(\\d+\\)"
      }
    },
    "line_reference": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\[\\d+\\]"
      }
    },
    "frame_identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\[[A-Za-z0-9_]+\\]"
      }
    },
    "default_namespace": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\(default\\)"
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\d+"
      }
    },
    "boolean_flag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "true"
        },
        {
          "type": "STRING",
          "value": "false"
        }
      ]
    },
    "event_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "timestamp",
          "content": {
            "type": "SYMBOL",
            "name": "timestamp"
          }
        },
        {
          "type": "FIELD",
          "name": "nanoseconds",
          "content": {
            "type": "SYMBOL",
            "name": "nanoseconds"
          }
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "user_debug_event"
            },
            {
              "type": "SYMBOL",
              "name": "soql_begin_event"
            },
            {
              "type": "SYMBOL",
              "name": "soql_end_event"
            },
            {
              "type": "SYMBOL",
              "name": "dml_begin_event"
            },
            {
              "type": "SYMBOL",
              "name": "dml_end_event"
            },
            {
              "type": "SYMBOL",
              "name": "method_entry_event"
            },
            {
              "type": "SYMBOL",
              "name": "method_exit_event"
            },
            {
              "type": "SYMBOL",
              "name": "code_unit_started_event"
            },
            {
              "type": "SYMBOL",
              "name": "code_unit_finished_event"
            },
            {
              "type": "SYMBOL",
              "name": "user_info_event"
            },
            {
              "type": "SYMBOL",
              "name": "variable_scope_event"
            },
            {
              "type": "SYMBOL",
              "name": "variable_assignment_event"
            },
            {
              "type": "SYMBOL",
              "name": "exception_thrown_event"
            },
            {
              "type": "SYMBOL",
              "name": "fatal_error_event"
            },
            {
              "type": "SYMBOL",
              "name": "generic_event"
            }
          ]
        }
      ]
    },
    "user_debug_event": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "event_type",
          "content": {
            "type": "STRING",
            "value": "USER_DEBUG"
          }
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "FIELD",
          "name": "line",
          "content": {
            "type": "SYMBOL",
            "name": "line_reference"
          }
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "FIELD",
          "name": "level",
          "content": {
            "type": "SYMBOL",
            "name": "log_level"
          }
        },
        {
          "type": "STRING",
          "value": "|"
